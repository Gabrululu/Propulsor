node_modules
agent/node_modules

# ── Build output ──────────────────────────────────────────────────────────────
dist
dist-ssr
agent/dist

# ── Environment variables (contain Stellar secrets — never commit) ────────────
.env
.env.*
!.env.example
agent/.env
agent/.env.*
!agent/.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Package manager lockfiles ─────────────────────────────────────────────────
bun.lockb
yarn.lock
package-lock.json

# ── ZK artifacts ──────────────────────────────────────────────────────────────
# Generated proof (contains public signals — not a secret, but ephemeral)
zk/scripts/proof_output.json

# Rust build output
zk/contracts/*/target/

# Circom build intermediaries (wasm + r1cs regenerated by `make all`)
zk/circuits/*/build/

# Trusted setup key (large binary, regenerated by `make setup`)
zk/circuits/*/circuit.zkey
zk/circuits/*/*.zkey

# snarkjs deps for zk/ subpackage
zk/node_modules/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage

