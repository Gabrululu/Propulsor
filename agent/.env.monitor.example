# ─────────────────────────────────────────────────────────────────────────────
# Propulsor — Autonomous Monitor (src/monitor.ts)
#
# This is a SEPARATE Railway service from the x402 payment server
# (src/server.ts / .env.example). One deployment of this process serves
# EVERY Propulsor user — it watches all Stellar Testnet USDC payments and
# reacts to any of them addressed to a known user account (fetched from
# Supabase via the agent-watchlist Edge Function, refreshed every 60s).
# There is no per-user account to configure here.
#
# Deploy it as its own Railway service:
#
#   1. Railway → your Propulsor project → + New → GitHub Repo → same repo
#   2. Service Settings → Root Directory: /agent
#   3. Service Settings → Custom Start Command: node dist/monitor.js
#      (the build command from railway.json — `npm install && npm run build`
#      — already compiles src/monitor.ts into dist/monitor.js, no changes needed)
#   4. Service Settings → Healthcheck Path: leave EMPTY. This process has no
#      HTTP server — it can never answer a healthcheck, and Railway will
#      mark the deploy as failed if one is configured.
#   5. Paste the variables below into that service's Variables tab
#   6. Deploy the agent-watchlist and agent-webhook Supabase Edge Functions
#      (see supabase/functions/) if you haven't already — the monitor is
#      useless without them, since it has no other way to know which
#      accounts to watch or to report activity back to the dashboard.
#   7. Deploy, then check Logs for:
#        Watching:          N account(s) (refreshed every 60s)
#        Waiting for incoming USDC payments...
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Secret key (starts with "S") that pays the 0.01 USDC x402 fee to trigger
# each split. Must belong to a funded Testnet account with a USDC trustline.
# Falls back to SERVER_STELLAR_SECRET if omitted — set this explicitly when
# using a dedicated keypair instead of reusing the server's.
AGENT_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL of the already-deployed x402 payment server (the OTHER Railway service).
# The monitor calls POST /execute-split here after detecting a payment.
AGENT_SERVER_URL=https://propulsor-production.up.railway.app

# Your Supabase project URL — the monitor calls two Edge Functions here:
#   agent-watchlist  (GET)  — which accounts to watch
#   agent-webhook    (POST) — reports activity back to the dashboard
SUPABASE_URL=https://kytfiqkjczkldrkolqqk.supabase.co

# Shared secret with BOTH the `agent-watchlist` and `agent-webhook` Supabase
# Edge Functions. MUST be the exact same value as each function's
# AGENT_WEBHOOK_SECRET secret (Supabase dashboard → Edge Functions →
# <function> → Secrets, or `supabase secrets set AGENT_WEBHOOK_SECRET=<value>`
# — set it once, both functions read the same project-level secret).
# A mismatch fails silently from the monitor's point of view — it logs a 401
# and keeps retrying every 60s, but never sees any accounts to watch.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_WEBHOOK_SECRET=

# ── Optional — Blend Protocol yield on vault_2 (savings) ─────────────────────
# If unset, splits still work; vault_2 just stays in the Stellar account
# instead of earning yield. See README.md "Blend Protocol integration" for
# how to get a pool ID and fund a vault_2 account.

# VAULT2_PUBLIC_KEY=G...
# VAULT2_SECRET=S...
# BLEND_POOL_ID=C...
