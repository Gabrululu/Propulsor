# ─────────────────────────────────────────────────────────────────────────────
# Propulsor — Autonomous Monitor (src/monitor.ts)
#
# This is a SEPARATE Railway service from the x402 payment server
# (src/server.ts / .env.example). Deploy it as its own service:
#
#   1. Railway → your Propulsor project → + New → GitHub Repo → same repo
#   2. Service Settings → Root Directory: /agent
#   3. Service Settings → Custom Start Command: node dist/monitor.js
#      (the build command from railway.json — `npm install && npm run build`
#      — already compiles src/monitor.ts into dist/monitor.js, no changes needed)
#   4. Paste the variables below into that service's Variables tab
#   5. Deploy, then check Logs for:
#        Watching account:  G...
#        Waiting for incoming USDC payments...
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# The Stellar public key to watch for incoming USDC. This is the end user's
# wallet — the monitor only ever reacts to payments sent TO this address.
WATCHED_ACCOUNT=GBK7YOS5ZKVDXVQOWKWJTZJCFQT7TCM2RLHNRZHCOBCZEQAVQACOTS2I

# Secret key (starts with "S") that pays the 0.01 USDC x402 fee to trigger
# each split. Must belong to a funded Testnet account with a USDC trustline.
# Falls back to SERVER_STELLAR_SECRET if omitted — set this explicitly when
# using a dedicated keypair instead of reusing the server's.
AGENT_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL of the already-deployed x402 payment server (the OTHER Railway service).
# The monitor calls POST /execute-split here after detecting a payment.
AGENT_SERVER_URL=https://propulsor-production.up.railway.app

# ── Required for the dashboard to show activity ──────────────────────────────
# Without these two, splits still execute on-chain but the monitor has no way
# to tell the frontend — the Agent status card and activity feed stay empty
# even though everything is technically working.

SUPABASE_URL=https://kytfiqkjczkldrkolqqk.supabase.co

# Shared secret with the `agent-webhook` Supabase Edge Function. MUST be the
# exact same value as the AGENT_WEBHOOK_SECRET secret configured for that
# function (Supabase dashboard → Edge Functions → agent-webhook → Secrets,
# or `supabase secrets set AGENT_WEBHOOK_SECRET=<value>`). A mismatch fails
# silently — the monitor logs a 401 from agent-webhook but keeps running.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_WEBHOOK_SECRET=

# ── Optional — Blend Protocol yield on vault_2 (savings) ─────────────────────
# If unset, splits still work; vault_2 just stays in the Stellar account
# instead of earning yield. See README.md "Blend Protocol integration" for
# how to get a pool ID and fund a vault_2 account.

# VAULT2_PUBLIC_KEY=G...
# VAULT2_SECRET=S...
# BLEND_POOL_ID=C...
