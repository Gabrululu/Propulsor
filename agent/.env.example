# Stellar keypair for the agent server (generate with Stellar Lab – see README)
# This account must be funded with XLM and have a USDC trustline
SERVER_STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server port (default: 3001)
PORT=3001

# Soroban RPC endpoint (Testnet)
RPC_URL=https://soroban-testnet.stellar.org

# x402 facilitator (public Stellar testnet facilitator)
FACILITATOR_URL=https://www.x402.org/facilitator


# ── Supabase (optional — enables transaction history + dashboard agent status) ─
# The agent never talks to the database directly (no service_role access on
# Lovable Cloud) — it only POSTs to the `agent-webhook` Edge Function, which
# does the writes with its own auto-injected SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Shared secret with the `agent-webhook` Edge Function — must match the value
# configured as a Supabase secret for that function.
# AGENT_WEBHOOK_SECRET=
